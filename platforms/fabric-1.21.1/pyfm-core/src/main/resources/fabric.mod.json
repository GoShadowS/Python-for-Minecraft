{
    "schemaVersion": 1,
    "id": "pythonforminecraft_core",
    "version": "${version}",
    "name": "Python for Minecraft (core)",
    "description": "Python-for-Minecraft: run ordinary Minecraft mods written in Python. Language provider, comparable to Fabric Language Kotlin and Kotlin for Forge.",
    "authors": [
    "GoShadowS"
    ],
    "contact": {
        "sources": "https://github.com/GoShadowS/Python-for-Minecraft"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "languageAdapters": {
        "python": "io.github.goshadows.pythonforminecraft.fabric.PythonLanguageAdapter"
    },
    "depends": {
        "fabricloader": ">=0.20.1",
        "minecraft": "~1.21.1",
        "java": ">=21"
    },
    "custom": {
        "pythonforminecraft:component": "pyfm-core"
    }
}
