{
    "schemaVersion": 1,
    "id": "pythonforminecraft",
    "version": "${version}",
    "name": "Python for Minecraft (client)",
    "description": "Python-for-Minecraft: run ordinary Minecraft mods written in Python. Language provider, comparable to Fabric Language Kotlin and Kotlin for Forge.",
    "authors": [
    "GoShadowS"
    ],
    "contact": {
        "sources": "https://github.com/GoShadowS/Python-for-Minecraft"
    },
    "license": "Apache-2.0",
    "environment": "client",
    "entrypoints": {
        "client": [
        "io.github.goshadows.pythonforminecraft.fabric.PyFmClient"
        ]
    },
    "depends": {
        "fabricloader": ">=0.20.1",
        "minecraft": "~26.3",
        "java": ">=25",
        "pythonforminecraft_core": ">=1.0.0",
        "fabric-api": "*"
    },
    "custom": {
        "pythonforminecraft:component": "pyfm-client"
    }
}
