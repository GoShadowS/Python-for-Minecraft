{
    "schemaVersion": 1,
    "id": "pyhello_client",
    "version": "${version}",
    "name": "PyHello Client (Python)",
    "description": "Client-only Python smoke test for Python-for-Minecraft.",
    "authors": [
        "GoShadowS"
    ],
    "contact": {
        "sources": "https://github.com/GoShadowS/Python-for-Minecraft"
    },
    "license": "Apache-2.0",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "adapter": "python",
                "value": "pyhello_client.entry:PyHelloClient"
            }
        ]
    },
    "custom": {
        "pythonforminecraft": {
            "python_root": "python",
            "modules": [
                "pyhello_client"
            ]
        }
    },
    "depends": {
        "pythonforminecraft_core": ">=1.0.0",
        "pythonforminecraft": ">=1.0.0",
        "fabricloader": ">=0.20.1",
        "minecraft": "~26.3",
        "java": ">=25"
    }
}
